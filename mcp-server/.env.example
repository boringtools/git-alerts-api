# GitAlerts API Configuration
GITALERTS_API_BASE_URL=http://localhost:8000

# Preferred: a refresh token from POST /api/token/ (30 day lifetime, auto-renewed).
GITALERTS_REFRESH_TOKEN=

# Alternative: a ready-made access token (24 hour lifetime, not renewed).
GITALERTS_API_TOKEN=

# Legacy only: the server logs in with your account password, which keeps the
# password in plain text. Issue a token instead.
GITALERTS_USERNAME=
GITALERTS_PASSWORD=
